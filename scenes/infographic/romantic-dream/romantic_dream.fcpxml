                                        <keyframe time="20s"    value="0.95 0.95"     curve="linear"/>
                                    </keyframeAnimation>
                                </param>
                                <param name="position">
                                    <keyframeAnimation>
                                        <keyframe time="0s"     value="25.9259 24.0741"   curve="linear"/>
                                        <keyframe time="2.3s"   value="25.9259 24.0741"   curve="linear"/>
                                        <keyframe time="6.4s"   value="26.3889 24.537"    curve="linear"/>
                                        <keyframe time="7.3s"   value="25.5556 23.7963"   curve="linear"/>
                                        <keyframe time="8.2s"   value="25.9259 24.0741"   curve="linear"/>
                                        <keyframe time="10.5s"  value="26.2037 24.3519"   curve="linear"/>
                                        <keyframe time="14s"    value="25.9259 24.0741"   curve="linear"/>
                                        <keyframe time="17.5s"  value="25.6481 23.7963"   curve="linear"/>
