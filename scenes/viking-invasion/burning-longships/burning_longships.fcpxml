<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>

<fcpxml version="1.14">
    <resources>
        <format id="r1" name="FFVideoFormat1080p30" frameDuration="1001/30030s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/>

        <!-- COMPOUND SCENE — all layers pre-composed here so the outer ref-clip can rock
             the whole flattened result as a single rigid unit (camera-on-the-beach effect).
             See ../../../context/methodology.md #5 for why this wrapper is required. -->
        <media id="r2" name="Burning Longships Compound" uid="burning_longships_compound_uid">
            <sequence format="r1" duration="20s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
                <spine>

                    <!-- BACKGROUND — sea/stormy sky, slowest pan (same slow drift amplitude
                         as approaching-britain's sky layer: +40px/-40px pre-divided by 10.8). -->
                    <asset-clip ref="r3" offset="0s" name="Background – Sea and Storm Sky" duration="20s" tcFormat="NDF">
                        <adjust-transform scale="1.2 1.2">
                            <param name="position" value="3.7037 0">
                                <keyframeAnimation>
                                    <keyframe time="0s" value="3.7037 0" curve="linear"/>
                                    <keyframe time="20s" value="-3.7037 0" curve="linear"/>
                                </keyframeAnimation>
                            </param>
                        </adjust-transform>

                        <!-- PAPER TEXTURE OVERLAY — universal asset, directly above background,
                             multiply blend, per ../../../context/requirements.md. -->
                        <asset-clip ref="r5" lane="1" offset="0s" name="Paper Texture Overlay" duration="20s" tcFormat="NDF">
                            <adjust-blend mode="multiply"/>
                        </asset-clip>

                        <!-- MIDGROUND — burning longships. Moderate pan (faster than background,
                             slower than the Viking foreground per the brief), plus a slow zoom-in
                             creep suggesting the fire consuming the ships over the clip. Kept sharp
                             (no blur) — this is the scene's visual subject even though it's not the
                             fastest-panning layer; see burning-longships Doc "Spec" note. -->
                        <asset-clip ref="r6" lane="2" offset="0s" name="Burning Longships" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="scale" value="1 1">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="1 1" curve="linear"/>
                                        <keyframe time="20s" value="1.06 1.06" curve="linear"/>
                                    </keyframeAnimation>
                                </param>
                                <param name="position" value="8.3333 0">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="8.3333 0" curve="linear"/>
                                        <keyframe time="20s" value="-8.3333 0" curve="linear"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>
                        </asset-clip>

                        <!-- FOREGROUND — Viking crowd, backs to camera. Fastest pan (largest
                             parallax amplitude) and the most out-of-focus layer, per
                             requirements.md's "closest to camera = most blur" rule — this takes
                             precedence over the default "subject stays sharp" pattern here since
                             the brief explicitly makes the Vikings the closest/fastest layer. -->
                        <asset-clip ref="r7" lane="3" offset="0s" name="Viking Backs" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="position" value="16.6667 0">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="16.6667 0" curve="linear"/>
                                        <keyframe time="20s" value="-16.6667 0" curve="linear"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>
                            <filter-video ref="r12" name="Gaussian">
                                <param name="Amount" key="9999/986883370/100/986883376/2/100" value="0.075"/>
                                <param name="Blur Boost" key="9999/986883370/100/986884620/2/100" value="0.108"/>
                            </filter-video>
                        </asset-clip>

                        <!-- LIGHTNING — reused overlay (same uid as viking-ocean/approaching-britain/
                             church-on-the-hill, methodology.md #6b), same "14 (Overlay)" blend string
                             confirmed working across this project. -->
                        <asset-clip ref="r8" lane="4" offset="0s" name="Lightning Overlay" duration="20s" tcFormat="NDF">
                            <adjust-transform scale="1.15 1.15"/>
                            <adjust-blend mode="14 (Overlay)"/>
                        </asset-clip>

                        <!-- EMBERS — procedural atmospheric overlay, add blend so only the bright
                             sparks contribute (reads as light in the air, not a pasted layer), with
                             a slow rise + gentle sideways drift over the clip. -->
                        <asset-clip ref="r9" lane="5" offset="0s" name="Embers Overlay" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="position" value="0 0">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="0 0" curve="smooth"/>
                                        <keyframe time="10s" value="2.7778 4.1667" curve="smooth"/>
                                        <keyframe time="20s" value="-2.7778 8.3333" curve="smooth"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>
                            <adjust-blend mode="add"/>
                        </asset-clip>

                    </asset-clip>
                </spine>
            </sequence>
        </media>

        <!-- Gaussian Blur effect — syntax confirmed via real FCP export, see methodology.md #7. -->
        <effect id="r12" name="Gaussian" uid=".../Effects.localized/Blur.localized/Gaussian.localized/Gaussian.moef"/>

        <asset id="r3" name="sky_sea_background" uid="burning_longships_sky_sea_mov_uid" start="0s" duration="20s" hasVideo="1" format="r1" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/viking-invasion/burning-longships/video/sky_sea_background.mov"/>
        </asset>

        <!-- Universal paper-texture overlay — own format (matches the source .mp4's native
             29.97fps), same uid as every other scene that already wires this in
             (great-awakening/fire-and-brimstone, inferno/satan-bound,
             infographic/religious-hysteria, puritans/arrival). Copy this uid verbatim for any
             future scene reusing this asset — see methodology.md #6b. -->
        <format id="r4" name="FFVideoFormat1080p2997" frameDuration="1001/30000s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/>
        <asset id="r5" name="paper_background" uid="paper_background_mp4_uid" start="0s" duration="19987/1000s" hasVideo="1" format="r4" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/universal-assets/paper_background.mp4"/>
        </asset>

        <asset id="r6" name="burning_longships" uid="burning_longships_ships_mov_uid" start="0s" duration="20s" hasVideo="1" format="r1" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/viking-invasion/burning-longships/video/burning_longships.mov"/>
        </asset>
        <asset id="r7" name="viking_backs" uid="burning_longships_vikings_mov_uid" start="0s" duration="20s" hasVideo="1" format="r1" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/viking-invasion/burning-longships/video/viking_backs.mov"/>
        </asset>

        <!-- LIGHTNING — reused file, same uid as the other viking-invasion scenes; this
             scene's own copy lives at its own video/ path per methodology.md #6b. -->
        <asset id="r8" name="lightning" uid="lightning_mov_uid" start="0s" duration="20s" hasVideo="1" format="r1" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/viking-invasion/burning-longships/video/lightning.mov"/>
        </asset>

        <asset id="r9" name="embers_overlay" uid="burning_longships_embers_mov_uid" start="0s" duration="20s" hasVideo="1" format="r1" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/viking-invasion/burning-longships/video/embers_overlay.mov"/>
        </asset>

        <!-- AUDIO — reused ambience + event layer, same uids as viking-ocean/approaching-britain
             (methodology.md #6b); this scene's own copies live at its own audio/ path. -->
        <asset id="r10" name="thunder" uid="thunder_audio_uid" start="0s" duration="20s" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/viking-invasion/burning-longships/audio/thunder.wav"/>
        </asset>
        <asset id="r11" name="ocean_waves" uid="ocean_waves_audio_uid" start="0s" duration="20s" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/viking-invasion/burning-longships/audio/ocean_waves.wav"/>
        </asset>
    </resources>

    <library>
        <event name="Viking Invasion">
            <project name="Burning Longships Scene">
                <sequence format="r1" duration="20s" tcStart="0s" audioLayout="stereo" audioRate="48k">
                    <spine>

                        <!-- CAMERA RIG — gentle whole-scene rock, same small-amplitude pattern as
                             viking-ocean/approaching-britain/church-on-the-hill (methodology.md #5). -->
                        <ref-clip ref="r2" offset="0s" name="Burning Longships – Camera Rig" duration="20s">
                            <adjust-transform scale="1.35 1.35">
                                <param name="rotation">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="0"/>
                                        <keyframe time="3s" value="1.3"/>
                                        <keyframe time="7s" value="-1.7"/>
                                        <keyframe time="11s" value="1.1"/>
                                        <keyframe time="15s" value="-1.4"/>
                                        <keyframe time="20s" value="0"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>

                            <asset-clip ref="r10" lane="-1" offset="0s" name="Thunder Audio" duration="20s" audioRole="effects"/>
                            <asset-clip ref="r11" lane="-2" offset="0s" name="Ocean Waves Audio" duration="20s" audioRole="effects">
                                <adjust-volume amount="-12dB"/>
                            </asset-clip>
                        </ref-clip>

                    </spine>
                </sequence>
            </project>
        </event>
    </library>
</fcpxml>
