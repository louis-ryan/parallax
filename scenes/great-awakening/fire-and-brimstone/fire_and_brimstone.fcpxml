<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>

<fcpxml version="1.14">
    <resources>
        <format id="r1" name="FFVideoFormat1080p30" frameDuration="100/3000s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/>
        <media id="r2" name="Revival Scene Compound" uid="great_awakening_revival_compound_uid">
            <sequence format="r1" duration="20s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
                <spine>
                    <asset-clip ref="r3" offset="0s" name="Background – Dusk Revival" duration="20s" tcFormat="NDF">
                        <asset-clip ref="r5" lane="1" offset="0s" name="Paper Texture Overlay" duration="20s" tcFormat="NDF">
                            <adjust-blend mode="multiply"/>
                        </asset-clip>
                        <asset-clip ref="r6" lane="2" offset="0s" name="Torchlight" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="scale" value="1 1">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="1 1" curve="smooth"/>
                                        <keyframe time="107107/30030s" value="1.05 1.05" curve="smooth"/>
                                        <keyframe time="257257/30030s" value="0.96 0.96" curve="smooth"/>
                                        <keyframe time="407407/30030s" value="1.04 1.04" curve="smooth"/>
                                        <keyframe time="577577/30030s" value="0.97 0.97" curve="smooth"/>
                                        <keyframe time="8s" value="1.06 1.06" curve="smooth"/>
                                        <keyframe time="10s" value="0.95 0.95" curve="smooth"/>
                                        <keyframe time="12s" value="1.05 1.05" curve="smooth"/>
                                        <keyframe time="14s" value="0.97 0.97" curve="smooth"/>
                                        <keyframe time="16s" value="1.04 1.04" curve="smooth"/>
                                        <keyframe time="18s" value="0.96 0.96" curve="smooth"/>
                                        <keyframe time="20s" value="1 1" curve="smooth"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>
                            <adjust-blend mode="add"/>
                        </asset-clip>
                        <asset-clip ref="r7" lane="3" offset="0s" name="Crowd – Left" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="position" value="-177.778 0">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="-177.778 0" curve="smooth"/>
                                        <keyframe time="6s" value="0 0" curve="smooth"/>
                                        <keyframe time="20s" value="0 0" curve="smooth"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>
                        </asset-clip>
                        <asset-clip ref="r8" lane="4" offset="0s" name="Crowd – Right" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="position" value="177.778 0">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="177.778 0" curve="smooth"/>
                                        <keyframe time="6s" value="0 0" curve="smooth"/>
                                        <keyframe time="20s" value="0 0" curve="smooth"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>
                        </asset-clip>
                        <asset-clip ref="r9" lane="5" offset="0s" name="Preacher" duration="20s" tcFormat="NDF"/>
                    </asset-clip>
                </spine>
            </sequence>
        </media>
