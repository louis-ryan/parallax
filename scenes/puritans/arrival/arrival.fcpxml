<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>

<fcpxml version="1.14">
    <resources>
        <format id="r1" name="FFVideoFormat1080p30" frameDuration="100/3000s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/>
        <media id="r2" name="Arrival Scene Compound" uid="puritans_arrival_compound_uid">
            <sequence format="r1" duration="20s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
                <spine>
                    <asset-clip ref="r3" offset="0s" name="Background – Wilderness" duration="20s" tcFormat="NDF">
                        <asset-clip ref="r5" lane="1" offset="0s" name="Paper Texture Overlay" duration="20s" tcFormat="NDF">
                            <adjust-blend mode="multiply"/>
                        </asset-clip>
                        <asset-clip ref="r6" lane="2" offset="0s" name="Water" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="position" value="0 0">
                                    <param name="X" key="1" value="0">
                                        <keyframeAnimation>
                                            <keyframe time="0s" value="0" curve="linear"/>
                                            <keyframe time="20s" value="-9.2593" curve="linear"/>
                                        </keyframeAnimation>
                                    </param>
                                </param>
                            </adjust-transform>
                        </asset-clip>
                        <asset-clip ref="r7" lane="3" offset="0s" name="Ship – Puritans Arriving" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="position" value="-166.667 0">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="-166.667 -1.852" curve="smooth"/>
                                        <keyframe time="14s" value="0 0" curve="smooth"/>
                                        <keyframe time="16s" value="0.5 -0.463" curve="smooth"/>
                                        <keyframe time="18s" value="0 0" curve="smooth"/>
                                        <keyframe time="20s" value="0.3 -0.463" curve="smooth"/>
                                    </keyframeAnimation>
                                </param>
                                <param name="rotation">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="-1.2" curve="smooth"/>
                                        <keyframe time="4s" value="0.8" curve="smooth"/>
                                        <keyframe time="8s" value="-0.6" curve="smooth"/>
                                        <keyframe time="12s" value="0.5" curve="smooth"/>
                                        <keyframe time="14s" value="0" curve="smooth"/>
                                        <keyframe time="17s" value="0.4" curve="smooth"/>
                                        <keyframe time="20s" value="-0.3" curve="smooth"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>
                        </asset-clip>
                    </asset-clip>
                </spine>
            </sequence>
        </media>
        <asset id="r3" name="background" uid="puritans_background_mov_uid" start="0s" duration="19987/1000s" hasVideo="1" format="r4" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/puritans/arrival/video/background.mov"/>
        </asset>
        <format id="r4" name="FFVideoFormat1080p2997" frameDuration="1001/30000s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/>
        <asset id="r5" name="paper_background" uid="paper_background_mp4_uid" start="0s" duration="19987/1000s" hasVideo="1" format="r4" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/universal-assets/paper_background.mp4"/>
        </asset>
        <asset id="r6" name="water" uid="puritans_water_mov_uid" start="0s" duration="19987/1000s" hasVideo="1" format="r4" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/puritans/arrival/video/water.mov"/>
        </asset>
        <asset id="r7" name="ship" uid="puritans_ship_mov_uid" start="0s" duration="19987/1000s" hasVideo="1" format="r4" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/puritans/arrival/video/ship.mov"/>
        </asset>
        <asset id="r8" name="coastal_ambience" uid="coastal_ambience_wav_uid" start="0s" duration="20s" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/puritans/arrival/audio/coastal_ambience.wav"/>
        </asset>
        <asset id="r9" name="coastal_events" uid="coastal_events_wav_uid" start="0s" duration="20s" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/puritans/arrival/audio/coastal_events.wav"/>
        </asset>
    </resources>
    <library>
        <event name="Puritans">
            <project name="Arrival">
                <sequence format="r1" duration="20s" tcStart="0s" audioLayout="stereo" audioRate="48k">
                    <spine>
                        <ref-clip ref="r2" offset="0s" name="Arrival Scene Compound" duration="20s">
                            <asset-clip ref="r8" lane="-1" offset="0s" name="Coastal Ambience" duration="20s" audioRole="effects">
                                <adjust-volume amount="-12dB"/>
                            </asset-clip>
                            <asset-clip ref="r9" lane="-2" offset="0s" name="Coastal Events" duration="20s" audioRole="effects"/>
                        </ref-clip>
                    </spine>
                </sequence>
            </project>
        </event>
    </library>
</fcpxml>
