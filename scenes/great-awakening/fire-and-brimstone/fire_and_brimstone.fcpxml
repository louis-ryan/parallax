    <library>
        <event name="Great Awakening">
            <project name="Fire and Brimstone">
                <sequence format="r1" duration="20s" tcStart="0s" audioLayout="stereo" audioRate="48k">
                    <spine>
                        <ref-clip ref="r2" offset="0s" name="Revival Scene Compound" duration="20s">
                            <asset-clip ref="r10" lane="-1" offset="0s" name="Revival Ambience" duration="20s" audioRole="effects">
                                <adjust-volume amount="-12dB"/>
                            </asset-clip>
                            <asset-clip ref="r11" lane="-2" offset="0s" name="Revival Events" duration="20s" audioRole="effects"/>
                        </ref-clip>
                    </spine>
                </sequence>
            </project>
        </event>
    </library>
