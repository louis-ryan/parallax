                                    </keyframeAnimation>
                                </param>
                                <param name="rotation">
                                    <keyframeAnimation>
                                        <keyframe time="0s"     value="0"     curve="linear"/>
                                        <keyframe time="2.08s"  value="0"     curve="linear"/>
                                        <keyframe time="2.1s"   value="-5.5"  curve="linear"/>
                                        <keyframe time="2.26s"  value="-5.5"  curve="linear"/>
                                        <keyframe time="2.3s"   value="-2.8"  curve="linear"/>
                                        <keyframe time="6.4s"   value="-2.8"  curve="linear"/>
                                        <keyframe time="7.3s"   value="-2.5"  curve="linear"/>
                                        <keyframe time="10.5s"  value="-2.8"  curve="linear"/>
                                        <keyframe time="14s"    value="-3.0"  curve="linear"/>
                                        <keyframe time="20s"    value="-2.8"  curve="linear"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>
                        </asset-clip>

                        <!-- Bubble 2 — Poncher/Vision of Death. Rest: true px (560, 380), scale 1.05. -->
                        <asset-clip ref="r8" lane="5" offset="0s" name="Thought – Death" duration="20s" tcFormat="NDF">
                            <adjust-transform>
