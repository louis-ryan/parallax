<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>

<!--
SOURCE ATTRIBUTION (all public domain, via Wikimedia Commons):
- Carl Spitzweg, "Der Zeitungsleser" / "Newspaper Reader in the Garden" (1868) — hero figure
- Francisco de Goya, "A Procession of Flagellants" (c.1814-1816) — thought bubble
- Master of the Chronique scandaleuse, "Denise Poncher before a Vision of Death"
  (c.1500, J. Paul Getty Museum / Poncher Hours) — thought bubble
- Michael Wolgemut, "Danse Macabre" (1493 woodcut, Nuremberg Chronicle) — thought bubble
- Anonymous, "Torturing and execution of witches" (14th c. medieval miniature,
  Chroniques de France ou de St Denis, British Library Royal MS 16 G VI) — thought bubble
-->

<fcpxml version="1.14">
    <resources>
        <format id="r1" name="FFVideoFormat1080p30" frameDuration="1001/30030s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/>

        <!-- COMPOUND SCENE — all layers pre-composed here, per the standard project
             pattern (see ../../../context/methodology.md). No whole-scene camera
             transform on the outer ref-clip — flat infographic collage, not a
             moving-camera environment scene. Structure mirrors
             ../religious-hysteria/religious_hysteria.fcpxml (Hessian base + multiply
             paper texture + stop-motion paper-cutout pieces), adapted for a
             "hero figure + rising thought-bubble chain" composition. -->
        <media id="r2" name="Romantic Dream Compound" uid="romantic_dream_compound_uid">
            <sequence format="r1" duration="20s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
                <spine>

                    <!-- HESSIAN BACKGROUND — true base layer, full frame, static, opaque.
                         Encoded generously oversized then cropped to 1920x1080 (NOT a
                         naive stretch of the 956x1000 source) so it genuinely fills the
                         frame horizontally — see ../style.md's "Background layering"
                         section, a fix the user had to apply by hand on the previous two
                         scenes. Reuses the SAME underlying hessian.jpg as
                         ../three-threats and ../religious-hysteria; this scene has its
                         own re-encoded .mov file, so its own scene-local asset id (r3),
                         but the uid MUST match those scenes' registered uid per
                         methodology.md bug #6b (both are already imported into the
                         user's FCP library). DTD ordering: adjust-transform before
                         adjust-blend (methodology.md bug #6c). -->
                    <asset-clip ref="r3" offset="0s" name="Hessian Background" duration="20s" tcFormat="NDF">
                        <adjust-transform scale="1.0 1.0"/>
                        <adjust-blend amount="0.7"/>

                        <!-- PAPER TEXTURE — multiply-blended over Hessian at full
                             opacity (only the Hessian gets the 70% opacity reduction,
                             per the user's instruction). Double-checked mode="multiply"
                             is actually present here, not just described in a comment —
                             this exact bug (blend mode silently missing/ineffective)
                             is what the user had to fix by hand on both prior scenes. -->
                        <asset-clip ref="r4" lane="1" offset="0s" name="Paper Texture (multiply)" duration="20s" tcFormat="NDF">
                            <adjust-transform scale="1.0 1.0"/>
                            <adjust-blend mode="multiply"/>
                        </asset-clip>

                        <!-- ================= HERO FIGURE =================
                             The Romantic gentleman, standing in his garden — Carl
                             Spitzweg's "Der Zeitungsleser". Largest/lowest element,
                             enters first. Rest position: true px (-380, -160), scale
                             1.35. All position/scale values pre-divided by 10.8 per
                             methodology.md bug #2. -->
                        <asset-clip ref="r5" lane="2" offset="0s" name="Hero – Romantic Figure" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="scale">
                                    <keyframeAnimation>
                                        <keyframe time="0s"     value="0 0"           curve="linear"/>
                                        <keyframe time="0.48s"  value="0 0"           curve="linear"/>
                                        <keyframe time="0.5s"   value="1.43 1.43"     curve="linear"/>
                                        <keyframe time="0.68s"  value="1.43 1.43"     curve="linear"/>
                                        <keyframe time="0.72s"  value="1.35 1.35"     curve="linear"/>
                                        <keyframe time="5s"     value="1.35 1.35"     curve="linear"/>
                                        <keyframe time="6s"     value="1.355 1.345"   curve="linear"/>
                                        <keyframe time="7.2s"   value="1.347 1.353"   curve="linear"/>
                                        <keyframe time="8.5s"   value="1.35 1.35"     curve="linear"/>
                                        <keyframe time="11s"    value="1.353 1.347"   curve="linear"/>
                                        <keyframe time="14s"    value="1.35 1.35"     curve="linear"/>
                                        <keyframe time="17.5s"  value="1.348 1.352"   curve="linear"/>
                                        <keyframe time="20s"    value="1.35 1.35"     curve="linear"/>
                                    </keyframeAnimation>
                                </param>
                                <param name="position">
                                    <keyframeAnimation>
                                        <keyframe time="0s"     value="-35.1852 -14.8148"  curve="linear"/>
                                        <keyframe time="0.72s"  value="-35.1852 -14.8148"  curve="linear"/>
                                        <keyframe time="6s"     value="-34.7222 -14.4444"  curve="linear"/>
                                        <keyframe time="7.2s"   value="-35.6481 -15.1852"  curve="linear"/>
                                        <keyframe time="8.5s"   value="-35.1852 -14.8148"  curve="linear"/>
                                        <keyframe time="11s"    value="-34.9074 -15.0926"  curve="linear"/>
                                        <keyframe time="14s"    value="-35.1852 -14.8148"  curve="linear"/>
                                        <keyframe time="17.5s"  value="-35.463 -14.537"    curve="linear"/>
                                        <keyframe time="20s"    value="-35.1852 -14.8148"  curve="linear"/>
                                    </keyframeAnimation>
                                </param>
                                <param name="rotation">
                                    <keyframeAnimation>
                                        <keyframe time="0s"     value="0"     curve="linear"/>
                                        <keyframe time="0.48s"  value="0"     curve="linear"/>
                                        <keyframe time="0.5s"   value="3.2"   curve="linear"/>
                                        <keyframe time="0.68s"  value="3.2"   curve="linear"/>
                                        <keyframe time="0.72s"  value="1.4"   curve="linear"/>
                                        <keyframe time="6s"     value="1.4"   curve="linear"/>
                                        <keyframe time="7.2s"   value="1.2"   curve="linear"/>
                                        <keyframe time="11s"    value="1.4"   curve="linear"/>
                                        <keyframe time="14s"    value="1.6"   curve="linear"/>
                                        <keyframe time="20s"    value="1.4"   curve="linear"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>
                        </asset-clip>

                        <!-- Trailing thought-circles connecting his head to the bubble
                             chain — enters second, right after the hero settles.
                             Rest position: true px (-40, 60), scale 1.0. -->
                        <asset-clip ref="r6" lane="3" offset="0s" name="Thought Trail" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="scale">
                                    <keyframeAnimation>
                                        <keyframe time="0s"     value="0 0"       curve="linear"/>
                                        <keyframe time="1.28s"  value="0 0"       curve="linear"/>
                                        <keyframe time="1.3s"   value="1.1 1.1"   curve="linear"/>
                                        <keyframe time="1.46s"  value="1.1 1.1"   curve="linear"/>
                                        <keyframe time="1.5s"   value="1.0 1.0"   curve="linear"/>
                                        <keyframe time="20s"    value="1.0 1.0"   curve="linear"/>
                                    </keyframeAnimation>
                                </param>
                                <param name="position" value="-3.7037 5.5556"/>
                            </adjust-transform>
                        </asset-clip>

                        <!-- ================= THOUGHT BUBBLE CHAIN =================
                             Four medieval-hysteria visions, staggered entrance rising
                             from near the head outward, each a stop-motion snap with
                             overshoot-bounce (same technique as ../three-threats and
                             ../religious-hysteria). Idle jitter ~5s-14s, hold to 20s. -->

                        <!-- Bubble 1 (nearest head) — Flagellants. Rest: true px (280, 260), scale 0.95. -->
                        <asset-clip ref="r7" lane="4" offset="0s" name="Thought – Flagellants" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="scale">
                                    <keyframeAnimation>
                                        <keyframe time="0s"     value="0 0"           curve="linear"/>
                                        <keyframe time="2.08s"  value="0 0"           curve="linear"/>
                                        <keyframe time="2.1s"   value="1.02 1.02"     curve="linear"/>
                                        <keyframe time="2.26s"  value="1.02 1.02"     curve="linear"/>
                                        <keyframe time="2.3s"   value="0.95 0.95"     curve="linear"/>
