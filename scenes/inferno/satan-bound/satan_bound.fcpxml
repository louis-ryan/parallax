<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>

<fcpxml version="1.14">
    <resources>
        <format id="r1" name="FFVideoFormat1080p30" frameDuration="100/3000s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/>
        <media id="r2" name="Hell Scene Compound" uid="inferno_satan_bound_compound_uid">
            <sequence format="r1" duration="20s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
                <spine>
                    <asset-clip ref="r3" offset="0s" name="Background – Cross Section" duration="20s" tcFormat="NDF">
                        <asset-clip ref="r5" lane="1" offset="0s" name="Paper Texture Overlay" duration="20s" tcFormat="NDF">
                            <adjust-blend mode="multiply"/>
                        </asset-clip>
                        <asset-clip ref="r6" lane="2" offset="0s" name="Fire Glow" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="scale" value="1 1">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="1 1" curve="smooth"/>
                                        <keyframe time="107107/30030s" value="1.04 1.04" curve="smooth"/>
                                        <keyframe time="257257/30030s" value="0.97 0.97" curve="smooth"/>
                                        <keyframe time="407407/30030s" value="1.03 1.03" curve="smooth"/>
                                        <keyframe time="577577/30030s" value="0.98 0.98" curve="smooth"/>
                                        <keyframe time="8s" value="1.05 1.05" curve="smooth"/>
                                        <keyframe time="10s" value="0.96 0.96" curve="smooth"/>
                                        <keyframe time="12s" value="1.04 1.04" curve="smooth"/>
                                        <keyframe time="14s" value="0.98 0.98" curve="smooth"/>
                                        <keyframe time="16s" value="1.03 1.03" curve="smooth"/>
                                        <keyframe time="18s" value="0.97 0.97" curve="smooth"/>
                                        <keyframe time="20s" value="1 1" curve="smooth"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>
                            <adjust-blend mode="add"/>
                        </asset-clip>
                        <asset-clip ref="r7" lane="3" offset="0s" name="Smoke Drift" duration="20s" tcFormat="NDF">
                            <adjust-transform scale="1.3 1.3">
                                <param name="position" value="0 0">
                                    <param name="Y" key="2" value="0">
                                        <keyframeAnimation>
                                            <keyframe time="0s" value="0" curve="linear"/>
                                            <keyframe time="20s" value="18.5185" curve="linear"/>
                                        </keyframeAnimation>
                                    </param>
                                </param>
                            </adjust-transform>
                            <adjust-blend mode="screen"/>
                        </asset-clip>
                    </asset-clip>
                </spine>
            </sequence>
        </media>
        <asset id="r3" name="background" uid="inferno_background_mov_uid" start="0s" duration="19987/1000s" hasVideo="1" format="r4" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/inferno/satan-bound/video/background.mov"/>
        </asset>
        <format id="r4" name="FFVideoFormat1080p2997" frameDuration="1001/30000s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/>
        <asset id="r5" name="paper_background" uid="paper_background_mp4_uid" start="0s" duration="19987/1000s" hasVideo="1" format="r4" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/universal-assets/paper_background.mp4"/>
        </asset>
        <asset id="r6" name="fire" uid="inferno_fire_mov_uid" start="0s" duration="19987/1000s" hasVideo="1" format="r4" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/inferno/satan-bound/video/fire.mov"/>
        </asset>
        <asset id="r7" name="smoke" uid="inferno_smoke_mov_uid" start="0s" duration="19987/1000s" hasVideo="1" format="r4" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/inferno/satan-bound/video/smoke.mov"/>
        </asset>
        <asset id="r8" name="hell_ambience" uid="hell_ambience_wav_uid" start="0s" duration="20s" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/inferno/satan-bound/audio/hell_ambience.wav"/>
        </asset>
        <asset id="r9" name="hell_events" uid="hell_events_wav_uid" start="0s" duration="20s" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/inferno/satan-bound/audio/hell_events.wav"/>
        </asset>
    </resources>
    <library>
        <event name="Inferno">
            <project name="Satan Bound">
                <sequence format="r1" duration="20s" tcStart="0s" audioLayout="stereo" audioRate="48k">
                    <spine>
                        <ref-clip ref="r2" offset="0s" name="Hell Scene Compound" duration="20s">
                            <asset-clip ref="r8" lane="-1" offset="0s" name="Hell Ambience" duration="20s" audioRole="effects">
                                <adjust-volume amount="-12dB"/>
                            </asset-clip>
                            <asset-clip ref="r9" lane="-2" offset="0s" name="Hell Events" duration="20s" audioRole="effects"/>
                        </ref-clip>
                    </spine>
                </sequence>
            </project>
        </event>
    </library>
</fcpxml>
