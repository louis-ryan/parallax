<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>

<fcpxml version="1.14">
    <resources>
        <format id="r1" name="FFVideoFormat1080p30" frameDuration="1001/30030s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/>

        <!-- COMPOUND SCENE — all layers pre-composed here so the outer ref-clip can rock
             the whole flattened result as a single rigid unit (camera-on-a-raft effect).
             See ../../context/methodology.md for why this wrapper is required. -->
        <media id="r2" name="Approaching Britain Compound" uid="approaching_britain_compound_uid">
            <sequence format="r1" duration="20s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
                <spine>

                    <!-- SKY — slight zoom-in + slow pan, matching the viking-ocean treatment -->
                    <asset-clip ref="r3" offset="0s" name="Sky – Facing the Island" duration="20s" tcFormat="NDF">
                        <adjust-transform scale="1.2 1.2">
                            <param name="position">
                                <keyframeAnimation>
                                    <keyframe time="0s" value="3.7037 0" curve="linear"/>
                                    <keyframe time="20s" value="-3.7037 0" curve="linear"/>
                                </keyframeAnimation>
                            </param>
                        </adjust-transform>

                        <!-- ISLAND — static midground, slight zoom-in only (suggests slow approach) -->
                        <asset-clip ref="r4" lane="1" offset="0s" name="Island – Britain on the Horizon" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="scale">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="1.0 1.0" curve="linear"/>
                                        <keyframe time="20s" value="1.08 1.08" curve="linear"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>
                        </asset-clip>

                        <!-- OCEAN FAR — small vertical bob + slow scale-up (less forward motion, further away) -->
                        <asset-clip ref="r5" lane="2" offset="0s" name="Ocean Far" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="scale">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="1.3 1.3" curve="linear"/>
                                        <keyframe time="20s" value="1.55 1.55" curve="linear"/>
                                    </keyframeAnimation>
                                </param>
                                <param name="position">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="0 6" curve="smooth"/>
                                        <keyframe time="2.5s" value="0 -6" curve="smooth"/>
                                        <keyframe time="5s" value="0 6" curve="smooth"/>
                                        <keyframe time="7.5s" value="0 -6" curve="smooth"/>
                                        <keyframe time="10s" value="0 6" curve="smooth"/>
                                        <keyframe time="12.5s" value="0 -6" curve="smooth"/>
                                        <keyframe time="15s" value="0 6" curve="smooth"/>
                                        <keyframe time="17.5s" value="0 -6" curve="smooth"/>
                                        <keyframe time="20s" value="0 6" curve="smooth"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>
                        </asset-clip>

                        <!-- OCEAN NEAR — larger vertical bob + faster scale-up (more forward motion, closer to camera) -->
                        <asset-clip ref="r6" lane="3" offset="0s" name="Ocean Near" duration="20s" tcFormat="NDF">
                            <adjust-transform>
                                <param name="scale">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="1.4 1.4" curve="linear"/>
                                        <keyframe time="20s" value="1.9 1.9" curve="linear"/>
                                    </keyframeAnimation>
                                </param>
                                <param name="position">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="0 18" curve="smooth"/>
                                        <keyframe time="2s" value="0 -18" curve="smooth"/>
                                        <keyframe time="4s" value="0 18" curve="smooth"/>
                                        <keyframe time="6s" value="0 -18" curve="smooth"/>
                                        <keyframe time="8s" value="0 18" curve="smooth"/>
                                        <keyframe time="10s" value="0 -18" curve="smooth"/>
                                        <keyframe time="12s" value="0 18" curve="smooth"/>
                                        <keyframe time="14s" value="0 -18" curve="smooth"/>
                                        <keyframe time="16s" value="0 18" curve="smooth"/>
                                        <keyframe time="18s" value="0 -18" curve="smooth"/>
                                        <keyframe time="20s" value="0 18" curve="smooth"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>
                        </asset-clip>

                        <!-- LIGHTNING — flashing overlay, additive blend, same storm as viking-ocean -->
                        <asset-clip ref="r7" lane="4" offset="0s" name="Lightning Overlay" duration="20s" tcFormat="NDF">
                            <adjust-transform scale="1.15 1.15"/>
                            <adjust-blend mode="14 (Overlay)"/>
                        </asset-clip>

                    </asset-clip>
                </spine>
            </sequence>
        </media>

        <asset id="r3" name="sky_background" uid="sky_background_mov_uid" start="0s" duration="20s" hasVideo="1" format="r1" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/approaching-britain/video/sky_background.mov"/>
        </asset>
        <asset id="r4" name="island" uid="island_mov_uid" start="0s" duration="20s" hasVideo="1" format="r1" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/approaching-britain/video/island.mov"/>
        </asset>
        <asset id="r5" name="ocean_far" uid="ocean_far_mov_uid" start="0s" duration="20s" hasVideo="1" format="r1" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/approaching-britain/video/ocean_far.mov"/>
        </asset>
        <asset id="r6" name="ocean_near" uid="ocean_near_mov_uid" start="0s" duration="20s" hasVideo="1" format="r1" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/approaching-britain/video/ocean_near.mov"/>
        </asset>
        <asset id="r7" name="lightning" uid="lightning_mov_uid" start="0s" duration="20s" hasVideo="1" format="r1" videoSources="1">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/approaching-britain/video/lightning.mov"/>
        </asset>
        <asset id="r8" name="thunder" uid="thunder_audio_uid" start="0s" duration="20s" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/approaching-britain/audio/thunder.wav"/>
        </asset>
        <asset id="r9" name="ocean_waves" uid="ocean_waves_audio_uid" start="0s" duration="20s" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000">
            <media-rep kind="original-media" src="file:///Users/louisryan/Desktop/parallax/scenes/approaching-britain/audio/ocean_waves.wav"/>
        </asset>
    </resources>

    <library>
        <event name="Approaching Britain">
            <project name="Approaching Britain Scene">
                <sequence format="r1" duration="20s" tcStart="0s" audioLayout="stereo" audioRate="48k">
                    <spine>

                        <!-- CAMERA RIG — same gentle whole-scene rock as viking-ocean -->
                        <ref-clip ref="r2" offset="0s" name="Approaching Britain – Camera Rig" duration="20s">
                            <adjust-transform scale="1.35 1.35">
                                <param name="rotation">
                                    <keyframeAnimation>
                                        <keyframe time="0s" value="0"/>
                                        <keyframe time="4s" value="1.6"/>
                                        <keyframe time="8s" value="-1.2"/>
                                        <keyframe time="12s" value="1.4"/>
                                        <keyframe time="16s" value="-1.6"/>
                                        <keyframe time="20s" value="0"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-transform>

                            <asset-clip ref="r8" lane="-1" offset="0s" name="Thunder Audio" duration="20s" audioRole="effects"/>
                            <asset-clip ref="r9" lane="-1" offset="0s" name="Ocean Waves Audio" duration="20s" audioRole="effects">
                                <adjust-volume amount="-12dB"/>
                            </asset-clip>
                        </ref-clip>

                    </spine>
                </sequence>
            </project>
        </event>
    </library>
</fcpxml>
